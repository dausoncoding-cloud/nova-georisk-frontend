{
  "name": "nova-georisk-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "api:generate": "openapi-typescript openapi/nova-browser-api.json -o src/shared/api/generated/nova-browser-api.d.ts",
    "api:check": "node scripts/check-generated-api.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "5.104.0",
    "geotiff": "^3.0.5",
    "leaflet": "^1.9.4",
    "openapi-fetch": "0.17.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "7.18.4",
    "shpjs": "^6.2.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/leaflet": "^1.9.21",
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "jsdom": "30.1.1",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  }
}
